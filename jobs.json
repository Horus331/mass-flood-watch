{
 "paused": false,
 "jobs": [
  {
   "id": "surr_pipe_b1",
   "kind": "surrogate_pipeline",
   "env": {
    "PLAN": "~/scratch/surrogate/plan_b1.json",
    "PER_TASK": "8",
    "WAIT_H": "20"
   }
  },
  {
   "id": "whatif_v1",
   "kind": "whatif_pipeline",
   "env": {
    "CONC": "8",
    "PART": "short"
   }
  },
  {
   "id": "vel_run_v1",
   "kind": "run_storm",
   "env": {
    "NAME": "leominster_vel",
    "STORM": "sep2023",
    "HOURS": "48",
    "RES": "20",
    "LF_PARITY": "1",
    "LF_LOSS": "cn",
    "LF_CN_SCALE": "0.88",
    "LF_INFIL_MMH": "2",
    "LF_QOUT": "1",
    "LF_VOUT": "1",
    "LF_SAVEINT": "300",
    "LF_VFRAMES": "1",
    "PUBLISH": "0"
   },
   "sbatch": {
    "partition": "quick",
    "time": "06:00:00",
    "mem": "96G"
   }
  },
  {
   "id": "vel_pack_v1",
   "kind": "pack_site",
   "env": {
    "NAME": "leominster_vel",
    "STORM": "sep2023",
    "SITE": "leominster_vel",
    "FLOW": "1"
   },
   "sbatch": {
    "partition": "long",
    "time": "03:00:00"
   },
   "after": [
    "vel_run_v1"
   ]
  }
 ]
}